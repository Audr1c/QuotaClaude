# Fixed line endings: scripts must stay executable on every system,
# whatever the cloner's autocrlf setting is.
* text=auto
*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.c    text eol=lf
*.rc   text eol=lf
*.svg  text eol=lf
*.in   text eol=lf
Makefile text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.png  binary
*.ico  binary
*.exe  binary
/claude-usage-tracker binary
